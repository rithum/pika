{
    "extends": "@pika/typescript-config/base.json",
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "sourceMap": true,
        "inlineSources": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "baseUrl": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "pika-shared/*": [
                "../../../packages/shared/src/*"
            ],
            "pika-shared": [
                "../../../packages/shared/src"
            ]
        }
    },
    "include": [
        "src",
        "bin",
        "lib/stacks",
        "../../../packages/shared/src",
        "infra",
        "lambda",
    ],
    "exclude": [
        "node_modules",
        "dist",
        "cdk.out"
    ]
}