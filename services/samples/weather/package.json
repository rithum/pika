{
    "name": "@pika/weather",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:wc": "vite build --watch --config vite.config.dev.ts",
        "serve:wc": "npx serve dev-dist -p 5173 --cors",
        "preview": "vite preview",
        "test": "jest",
        "lint": "eslint src/",
        "copy-pika-config": "mkdir -p bin/build && cp ../../../pika-config.ts bin/build",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf cdk.out && rm -rf build",
        "check-types:lambda": "tsc -p tsconfig.cdk.json --noEmit",
        "check-types:webcomponent": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
        "check-types": "pnpm run check-types:lambda && pnpm run check-types:webcomponent",
        "cdk": "cdk",
        "cdk:synth": "pnpm run build && pnpm run copy-pika-config && cdk synth -c stage=${STAGE:-test}",
        "cdk:deploy": "pnpm run build && pnpm run copy-pika-config && cdk deploy -c stage=${STAGE:-test}",
        "cdk:diff": "cdk diff",
        "upload-tag-defs": "tsx tools/upload-tag-defs/index.ts",
        "buid-upload-tag-defs": "pnpm run build && pnpm run upload-tag-defs"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@aws-sdk/client-ssm": "catalog:",
        "@aws-sdk/client-sts": "catalog:",
        "@pika/typescript-config": "workspace:*",
        "@types/aws-lambda": "catalog:",
        "@types/jest": "catalog:",
        "@types/node": "catalog:",
        "@types/papaparse": "catalog:",
        "aws-cdk": "catalog:",
        "aws-cdk-lib": "catalog:",
        "aws-lambda": "catalog:",
        "constructs": "catalog:",
        "esbuild": "catalog:",
        "eslint": "catalog:",
        "jest": "catalog:",
        "papaparse": "catalog:",
        "ts-jest": "catalog:",
        "ts-node": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "@iconify-json/ci": "catalog:",
        "@iconify-json/lucide": "catalog:",
        "@internationalized/date": "catalog:",
        "@lucide/svelte": "catalog:",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@tailwindcss/typography": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@tsconfig/svelte": "catalog:",
        "bits-ui": "catalog:",
        "clsx": "catalog:",
        "pika-ux": "workspace:*",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "tailwind-merge": "catalog:",
        "tailwind-variants": "catalog:",
        "tailwindcss": "catalog:",
        "tw-animate-css": "catalog:",
        "unplugin-icons": "catalog:",
        "vite": "catalog:"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-agent-runtime": "catalog:",
        "@aws-sdk/client-bedrock-runtime": "catalog:",
        "@aws-sdk/client-lambda": "catalog:",
        "pika-shared": "workspace:*",
        "source-map-support": "catalog:"
    },
    "files": [
        "build/**"
    ]
}