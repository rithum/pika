{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/lambda/**/*",
    "bin/**/*",
    "lib/**/*",
    "test/**/*",
    "../../pika-config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "cdk.out",
    "src/webcomponent/**/*"
  ]
}