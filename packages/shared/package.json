{
    "name": "pika-shared",
    "version": "1.4.6",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./types/*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/types/*.mjs",
            "require": "./dist/types/*.js"
        },
        "./util/*": {
            "types": "./dist/util/*.d.ts",
            "import": "./dist/util/*.mjs",
            "require": "./dist/util/*.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src/",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "check-types": "tsc --noEmit",
        "prepack": "pnpm run build",
        "prepublishOnly": "echo 'Publishing pika-app...' && pnpm run build",
        "version:patch": "pnpm version patch --git-tag-version=true",
        "version:minor": "pnpm version minor --git-tag-version=true",
        "version:major": "pnpm version major --git-tag-version=true",
        "release:patch": "pnpm run version:patch && pnpm publish && git push && git push --tags",
        "release:minor": "pnpm run version:minor && pnpm publish && git push && git push --tags",
        "release:major": "pnpm run version:major && pnpm publish && git push && git push --tags",
        "release:dry": "pnpm publish --dry-run"
    },
    "devDependencies": {
        "@aws-sdk/client-bedrock-agent-runtime": "catalog:",
        "@aws-sdk/client-bedrock-agentcore": "catalog:",
        "@pika/typescript-config": "workspace:*",
        "@types/aws-lambda": "catalog:",
        "@types/jsonwebtoken": "catalog:",
        "@types/node": "catalog:",
        "aws-lambda": "catalog:",
        "eslint": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:"
    },
    "keywords": [
        "pika",
        "chatbot",
        "agent",
        "ai",
        "chatapp"
    ],
    "files": [
        "dist/**"
    ],
    "dependencies": {
        "camelcase-keys": "catalog:",
        "jsonwebtoken": "catalog:",
        "snakecase-keys": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rithum/pika.git",
        "directory": "packages/pika-cli"
    },
    "bugs": {
        "url": "https://github.com/rithum/pika/issues"
    },
    "homepage": "https://github.com/rithum/pika#readme",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}