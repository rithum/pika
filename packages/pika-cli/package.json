{
    "name": "pika-app",
    "version": "1.5.0",
    "description": "CLI tool for creating and managing Pika framework chat applications",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "pika": "dist/index.js"
    },
    "scripts": {
        "build": "tsup",
        "build:watch": "tsup --watch",
        "dev": "tsup --watch",
        "start": "node dist/index.js",
        "clean": "rm -rf dist",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "type-check": "tsc --noEmit",
        "prepack": "pnpm run build",
        "prepublishOnly": "echo 'Publishing pika-app...' && pnpm run build",
        "version:patch": "pnpm version patch --git-tag-version=true",
        "version:minor": "pnpm version minor --git-tag-version=true",
        "version:major": "pnpm version major --git-tag-version=true",
        "release:patch": "pnpm run version:patch && pnpm publish && git push && git push --tags",
        "release:minor": "pnpm run version:minor && pnpm publish && git push && git push --tags",
        "release:major": "pnpm run version:major && pnpm publish && git push && git push --tags",
        "release:dry": "pnpm publish --dry-run"
    },
    "keywords": [
        "pika",
        "chatbot",
        "aws",
        "cli",
        "framework",
        "bedrock",
        "svelte"
    ],
    "author": "Pika Framework Team",
    "license": "MIT",
    "dependencies": {
        "chalk": "catalog:",
        "commander": "catalog:",
        "diff": "catalog:",
        "fs-extra": "catalog:",
        "glob": "catalog:",
        "ignore": "catalog:",
        "inquirer": "catalog:",
        "minimatch": "catalog:",
        "mustache": "catalog:",
        "ora": "catalog:",
        "semver": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@pika/eslint-config": "workspace:*",
        "@pika/typescript-config": "workspace:*",
        "@types/fs-extra": "catalog:",
        "@types/inquirer": "catalog:",
        "@types/jest": "catalog:",
        "@types/mustache": "catalog:",
        "@types/node": "catalog:",
        "@types/semver": "catalog:",
        "jest": "catalog:",
        "ts-jest": "catalog:",
        "tsup": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rithum/pika.git",
        "directory": "packages/pika-cli"
    },
    "bugs": {
        "url": "https://github.com/rithum/pika/issues"
    },
    "homepage": "https://github.com/rithum/pika#readme",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "files": [
        "dist",
        "templates",
        "scripts",
        "README.md"
    ]
}