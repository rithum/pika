{
    "name": "weather-service-typescript-example",
    "version": "1.0.0",
    "description": "Weather service example using TypeScript serverless.ts configuration with Pika Serverless Plugin",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "deploy": "serverless deploy",
        "deploy:dev": "serverless deploy --stage dev",
        "deploy:prod": "serverless deploy --stage prod",
        "remove": "serverless remove",
        "invoke:local": "serverless invoke local --function weatherFunction --data '{\"function\": \"getCurrentWeather\", \"parameters\": {\"latitude\": 37.7749, \"longitude\": -122.4194}, \"actionGroup\": \"weather-tools\"}'",
        "logs": "serverless logs --function weatherFunction --tail",
        "test": "echo \"No tests specified\" && exit 0"
    },
    "devDependencies": {
        "pika-serverless": "workspace:*",
        "@serverless/typescript": "^3.38.0",
        "@types/aws-lambda": "^8.10.145",
        "@types/node": "^22.0.0",
        "serverless": "^3.38.0",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "aws-lambda": "^1.0.7"
    }
}
